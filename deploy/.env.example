# Copy to .env, next to docker-compose.yml, and fill in.

# The name players reach the server by. Its DNS record must point at this machine before the
# first start. Without a domain: the machine's public IPv4 address, and the second line.
P3P2_DOMAIN=p3p2.example.com
#P3P2_CADDYFILE=Caddyfile.ip

# Any server setting from the README's table goes here too, for example:
#P3P2_MAX_ROOMS=50
# Single quotes keep a $ or a # in a value as it is.
#P3P2_OWNER_PASSWORD='…'

# To build the server from this checkout instead of pulling p3p2/p3p2 (docs/self-host.md, "Building from a
# checkout"):
#COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
